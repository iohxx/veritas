# Environment variables are read from the process; .env is not auto-loaded.
VERITAS_DATA_DIR=data
VERITAS_ROOM=veritas
VERITAS_TECHNOCORE_URL=https://technocore.chat
VERITAS_MAX_JOBS_PER_HOUR=20
VERITAS_MAX_POSTS_PER_HOUR=20
VERITAS_MAX_INFERENCE_PER_JOB=1
VERITAS_MAX_SOURCE_SIZE=1048576
VERITAS_MAX_JOB_SIZE=65536
VERITAS_REQUEST_TIMEOUT=15
VERITAS_INFERENCE_PROVIDER=ollama
VERITAS_INFERENCE_URL=http://127.0.0.1:11434/api/chat
VERITAS_MODEL=qwen3:4b
VERITAS_LOG_LEVEL=INFO
# Set VERITAS_API_KEY only in your local process, never in committed files.
# JSON object; keys must match exactly and weights must sum to 100.
VERITAS_CONFIDENCE_WEIGHTS={"accessibility":15,"support":30,"numerical":25,"analysis":20,"contradictions":10}
